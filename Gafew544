-- ฟังก์ชันใส่/ถอด ชุดถุงคลุมตัว
local function UpdateBagCostumes()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then
            local char = plr.Character
            local existingBag = char:FindFirstChild("GafewBagCostume")
            if BagCostumeEnabled then
                if not existingBag and char:FindFirstChild("HumanoidRootPart") then
                    local bag = Instance.new("Part")
                    bag.Name = "GafewBagCostume"
                    bag.Size = Vector3.new(3, 5, 3)
                    bag.Color = Color3.fromRGB(163, 124, 82)
                    bag.Material = Enum.Material.Fabric
                    bag.CanCollide = false
                    
                    local weld = Instance.new("Weld", bag)
                    weld.Part0 = char.HumanoidRootPart
                    weld.Part1 = bag
                    weld.C0 = CFrame.new(0, 0, 0)
                    bag.Parent = char
                end
            else
                if existingBag then existingBag:Destroy() end
            end
        end
    end
end

-- Main Heartbeat Loop
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local myHRP = char:FindFirstChild("HumanoidRootPart")

    if (NoclipEnabled or FlingActive) then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    if FullbrightEnabled then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
    end

    if BagCostumeEnabled then UpdateBagCostumes() end

    -- ฟังก์ชันหลุมดำดูดคนทั้งเซิร์ฟ (Cosmic Black Hole)
    if BlackHoleEnabled and myHRP then
        local blackHolePos = myHRP.CFrame * CFrame.new(0, 15, 0)
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local tHRP = plr.Character:FindFirstChild("HumanoidRootPart")
                if tHRP then
                    tHRP.CFrame = blackHolePos * CFrame.Angles(0, math.rad(tick() * 100 % 360), 0) * CFrame.new(0, 0, math.random(2, 6))
                end
            end
        end
    end
end)

-- ESP มองทะลุ
local function UpdateESP()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local highlight = plr.Character:FindFirstChild("GafewESP")
            if EspEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "GafewESP"
                    highlight.FillColor = Color3.fromRGB(180, 70, 255)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.4
                    highlight.OutlineTransparency = 0
                    highlight.Parent = plr.Character
                end
            else
                if highlight then highlight:Destroy() end
            end
        end
    end
end


    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bolt = Instance.new("Part")
    bolt.Size = Vector3.new(2, 100, 2)
    bolt.Color = Color3.fromRGB(255, 255, 100)
    bolt.Material = Enum.Material.Neon
    bolt.CFrame = hrp.CFrame * CFrame.new(0, 50, 0)
    bolt.Anchored = true
    bolt.CanCollide = false
    bolt.Parent = workspace

    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://138090596"
    sound.Volume = 3
    sound.Parent = hrp
    sound:Play()

    Debris:AddItem(bolt, 0.3)

    for _, item in pairs(char:GetChildren()) do
        if item:IsA("Accessory") or item:IsA("Shirt") or item:IsA("Pants") then
            item:Destroy()
        end
    end

    local banana = Instance.new("Part")
    banana.Name = "BananaBody"
    banana.Size = Vector3.new(4, 9, 4)
    banana.Color = Color3.fromRGB(255, 225, 0)
    banana.Material = Enum.Material.SmoothPlastic
    banana.Shape = Enum.PartType.Cylinder
    banana.CanCollide = false

    local weld = Instance.new("Weld", banana)
    weld.Part0 = hrp
    weld.Part1 = banana
    weld.C0 = CFrame.Angles(0, 0, math.rad(90))
    banana.Parent = char

    local aura = Instance.new("Highlight")
    aura.FillColor = Color3.fromRGB(255, 255, 0)
    aura.OutlineColor = Color3.fromRGB(255, 150, 0)
    aura.Parent = char

    Rayfield:Notify({Title = "Gafew👽👾", Content = "ฟ้าผ่ากลายร่างเป็นกล้วยยักษ์แล้ว!", Duration = 3})
end

-- 2. คลื่นทำลายล้างรอบตัว (Annihilation Wave)
local function ReleaseAnnihilationWave()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local wave = Instance.new("Part")
    wave.Size = Vector3.new(1, 1, 1)
    wave.Color = Color3.fromRGB(180, 70, 255)
    wave.Material = Enum.Material.Neon
    wave.Shape = Enum.PartType.Ball
    wave.Anchored = true
    wave.CanCollide = false
    wave.CFrame = hrp.CFrame
    wave.Parent = workspace

    TweenService:Create(wave, TweenInfo.new(0.6, Enum.EasingStyle.Expo, Enum.EasingDirection.Out), {
        Size = Vector3.new(60, 60, 60),
        Transparency = 1
    }):Play()
    Debris:AddItem(wave, 0.6)

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local tHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if tHRP and (tHRP.Position - hrp.Position).Magnitude <= 35 then
                local bVel = Instance.new("BodyVelocity")
                bVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                bVel.Velocity = (tHRP.Position - hrp.Position).Unit * 300 + Vector3.new(0, 150, 0)
                bVel.Parent = tHRP
                Debris:AddItem(bVel, 0.4)
            end
        end
    end
    Rayfield:Notify({Title = "Gafew👽👾", Content = "ปล่อยคลื่นทำลายล้างรอบทิศ!", Duration = 2})
end


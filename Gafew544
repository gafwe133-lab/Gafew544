local function RemoveSuperman()
    IsSuperman = false
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = WalkSpeedValue end
        local aura = char:FindFirstChild("SupermanAura")
        if aura then aura:Destroy() end
    end
    Rayfield:Notify({Title = "Gafew👽👾", Content = "กลับเป็นร่างปกติแล้ว!", Duration = 2})
end

local function ApplySupermanSuit(char)
    IsSuperman = true
    local hum = char:WaitForChild("Humanoid")
    hum.WalkSpeed = WalkSpeedValue > 16 and WalkSpeedValue or 150

    for _, v in pairs(char:GetChildren()) do
        if v:IsA("Shirt") or v:IsA("Pants") then v:Destroy() end
    end

    local shirt = Instance.new("Shirt", char)
    shirt.ShirtTemplate = "http://www.roblox.com/asset/?id=10931215"
    local pants = Instance.new("Pants", char)
    pants.PantsTemplate = "http://www.roblox.com/asset/?id=10931221"

    local aura = Instance.new("Highlight")
    aura.Name = "SupermanAura"
    aura.FillColor = Color3.fromRGB(255, 215, 0)
    aura.OutlineColor = Color3.fromRGB(147, 112, 219)
    aura.FillTransparency = 0.4
    aura.Parent = char
end

local function StartFunnySequence()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    Rayfield:Notify({Title = "Gafew👽👾", Content = "เริ่มฉากสุดปั่น...", Duration = 3})

    for _, item in pairs(char:GetChildren()) do
        if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("Accessory") then
            item:Destroy()
        end
    end

    task.wait(0.8)

    local plane = Instance.new("Part")
    plane.Size = Vector3.new(15, 8, 35)
    plane.Color = Color3.fromRGB(120, 120, 120)
    plane.Material = Enum.Material.Metal
    plane.CFrame = hrp.CFrame * CFrame.new(0, 80, -20) * CFrame.Angles(math.rad(-45), 0, 0)
    plane.CanCollide = false
    plane.Parent = workspace

    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://138090596"
    sound.Volume = 2
    sound.Parent = plane
    sound:Play()

    local planeTween = TweenService:Create(plane, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        CFrame = hrp.CFrame
    })
    planeTween:Play()
    planeTween.Completed:Wait()

    local exp = Instance.new("Explosion")
    exp.Position = hrp.Position
    exp.BlastRadius = 25
    exp.BlastPressure = 500000
    exp.Parent = workspace

    plane:Destroy()
    hum.Health = 0

    Rayfield:Notify({Title = "Gafew👽👾", Content = "เกิดใหม่เป็น SUPERMAN!", Duration = 4})

    local connection
    connection = LocalPlayer.CharacterAdded:Connect(function(newChar)
        connection:Disconnect()
        task.wait(1)
        ApplySupermanSuit(newChar)
    end)
end

local function SafeFlingTarget(targetName)
    local targetPlr = Players:FindFirstChild(targetName)
    if not targetPlr or not targetPlr.Character then return end

    local myChar = LocalPlayer.Character
    local targetChar = targetPlr.Character
    if not myChar or not targetChar then return end

    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if not myHRP or not targetHRP or not myHum then return end

    FlingActive = true
    local originalCFrame = myHRP.CFrame
    myHum.PlatformStand = true

    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(0, 999999, 0)
    bav.Parent = myHRP

    local startTime = tick()
    local flingLoop
    flingLoop = RunService.Heartbeat:Connect(function()
        if tick() - startTime > 2 or not FlingActive or not targetHRP or not targetHRP.Parent then
            flingLoop:Disconnect()
            bav:Destroy()
            myHRP.Velocity = Vector3.zero
            myHRP.RotVelocity = Vector3.zero
            myHRP.CFrame = originalCFrame
            myHum.PlatformStand = false
            FlingActive = false
            Rayfield:Notify({Title = "Gafew👽👾", Content = "วาร์ปกลับจุดเดิมเรียบร้อย!", Duration = 2})
            return
        end
        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 0)
        myHRP.Velocity = Vector3.new(9999, 9999, 9999)
    end)
end

local function GiveCyberKatana()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return end

    local tool = Instance.new("Tool")
    tool.Name = "Cyber Katana"
    tool.Grip = CFrame.new(0, -1.2, 0) * CFrame.Angles(math.rad(-90), 0, 0)

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.3, 1.5, 0.3)
    handle.Color = Color3.fromRGB(20, 20, 20)
    handle.Parent = tool

    local blade = Instance.new("Part")
    blade.Name = "Blade"
    blade.Size = Vector3.new(0.1, 4.5, 0.5)
    blade.Color = Color3.fromRGB(180, 70, 255)
    blade.Material = Enum.Material.Neon
    blade.CanCollide = false

    local mesh = Instance.new("SpecialMesh", blade)
    mesh.MeshType = Enum.MeshType.Wedge
    mesh.Scale = Vector3.new(0.2, 4.5, 0.8)

    local weld = Instance.new("Weld", handle)
    weld.Part0 = handle
    weld.Part1 = blade
    weld.C0 = CFrame.new(0, 2.5, 0) * CFrame.Angles(0, math.rad(180), 0)
    blade.Parent = tool

    local attacking = false
    tool.Activated:Connect(function()
        if attacking then return end
        attacking = true
        local myChar = tool.Parent
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

        if myHRP then
            local wave = Instance.new("Part")
            wave.Size = Vector3.new(1, 1, 1)
            wave.Color = Color3.fromRGB(180, 70, 255)
            wave.Material = Enum.Material.Neon
            wave.Shape = Enum.PartType.Ball
            wave.Anchored = true
            wave.CanCollide = false
            wave.CFrame = myHRP.CFrame * CFrame.new(0, 0, -3)
            wave.Parent = workspace

            TweenService:Create(wave, TweenInfo.new(0.25), {
                Size = Vector3.new(12, 12, 12),
                Transparency = 1
            }):Play()
            Debris:AddItem(wave, 0.25)

            for _, target in pairs(Players:GetPlayers()) do
                if target ~= LocalPlayer and target.Character then
                    local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                    if tHRP and (tHRP.Position - myHRP.Position).Magnitude <= 12 then
                        local bVel = Instance.new("BodyVelocity")
                        bVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                        bVel.Velocity = (myHRP.CFrame.LookVector * 200) + Vector3.new(0, 150, 0)
                        bVel.Parent = tHRP
                        Debris:AddItem(bVel, 0.3)
                    end
                end
            end
        end
        task.wait(0.4)
        attacking = false
    end)
    tool.Parent = backpack
    Rayfield:Notify({Title = "Gafew👽👾", Content = "ได้รับ Cyber Katana แล้ว!", Duration = 2})
end

-- ฟังก์ชันรีเซ็ตค่าทั้งหมดกลับเป็นเริ่มต้น
local function ResetAllSettings()
    WalkSpeedValue = DEFAULT_WALKSPEED
    JumpPowerValue = DEFAULT_JUMPPOWER
    InfiniteJumpEnabled = false
    NoclipEnabled = false
    EspEnabled = false
    FullbrightEnabled = false
    BagCostumeEnabled = false
    BlackHoleEnabled = false

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = DEFAULT_WALKSPEED
            hum.JumpPower = DEFAULT_JUMPPOWER
        end
        local banana = char:FindFirstChild("BananaBody")
        if banana then banana:Destroy() end
    end

    Lighting.Brightness = 1
    Lighting.GlobalShadows = true

    UpdateESP()
    UpdateBagCostumes()
    RemoveSuperman()

    Rayfield:Notify({Title = "Gafew👽👾", Content = "รีเซ็ตตั้งค่าทั้งหมดกลับเป็นเริ่มต้นแล้ว!", Duration = 3})
end

local function GetPlayerNames()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(list, p.Name) end
    end
    return list
end

